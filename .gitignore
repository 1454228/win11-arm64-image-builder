# ===== 排除：崩溃 core dump =====
core.*
core

# ===== 排除：预览/截图（开发辅助，非源码）=====
*.png
shots/

# ===== 排除：打包产物 / 离线依赖（体积大，走单独分发）=====
*.zip
offline_bundle/
wheels/

# ===== 排除：GPU 驱动二进制包（约 160MB 专有 blob，走单独分发，不进仓库）=====
gui/builder/windows/files/gpu-arm64-drivers/

# ===== 排除：运行时日志 / pid / 本地配置（含凭据与本地路径，不进仓库）=====
*.log
*.pid
gui/logs/
gui/build_config.json

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo

# ===== 系统 / IDE =====
.DS_Store
Thumbs.db
.idea/
.vscode/
