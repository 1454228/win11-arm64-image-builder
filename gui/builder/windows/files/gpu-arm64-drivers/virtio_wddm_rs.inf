dx12um_virtio_arm64.dll = 1,,
dx12um_virtio_arm64ec.dll = 1,,
vulkan_freedreno.dll = 1,,
vulkan_freedreno_arm64.dll = 1,,
vulkan_freedreno_arm64ec.dll = 1,,
droidvm_vulkan.dll = 1,,
droidvm_vulkan_arm64.dll = 1,,
droidvm_vulkan_arm64ec.dll = 1,,
droidvm_opengl.dll = 1,,
droidvm_opengl_arm64.dll = 1,,
droidvm_opengl_arm64ec.dll = 1,,
freedreno_icd.arm64x.json = 1,,

[Manufacturer]
%ManufacturerName%=Standard,NTarm64.10.0...16299

[Standard.NTarm64.10.0...16299]
%VirtioGpu.DeviceDesc% = VirtioGpu_Inst, PCI\VEN_1AF4&DEV_1050&SUBSYS_10501AF4&REV_01

[VirtioGpu_Files.Driver]
virtio_wddm_rs.sys,,,2

[VirtioGpu_Files.Usermode]
freedreno_icd.x86.json,,,0
droidvm_opengl_x86.dll,,,0
dx11um_virtio_x86.dll,,,0
vulkan_freedreno_x86.dll,,,0
droidvm_vulkan_x86.dll,,,0
dx12um_virtio_x86.dll,,,0
dx11um_virtio.dll,,,0
dx11um_virtio_arm64.dll,,,0
dx11um_virtio_arm64ec.dll,,,0
dx12um_virtio.dll,,,0
dx12um_virtio_arm64.dll,,,0
dx12um_virtio_arm64ec.dll,,,0
vulkan_freedreno.dll,,,0
vulkan_freedreno_arm64.dll,,,0
vulkan_freedreno_arm64ec.dll,,,0
droidvm_vulkan.dll,,,0
