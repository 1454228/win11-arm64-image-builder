droidvm_vulkan_arm64ec.dll,,,0
droidvm_opengl.dll,,,0
droidvm_opengl_arm64.dll,,,0
droidvm_opengl_arm64ec.dll,,,0
freedreno_icd.arm64x.json,,,0

[VirtioGpu_Inst]
Include=msdv.inf
FeatureScore=F9
CopyFiles=VirtioGpu_Files.Driver, VirtioGpu_Files.Usermode
AddReg=VirtioGpu_DeviceSettings

[VirtioGpu_Inst.Services]
AddService = VirtioGpu,0x00000002,VirtioGpu_Service_Inst, VirtioGpu_EventLog_Inst

[VirtioGpu_Inst.HW]
AddReg = VirtioGpu_PCI_MSIX

[VirtioGpu_Service_Inst]
ServiceType = %SERVICE_KERNEL_DRIVER%
StartType = %SERVICE_DEMAND_START%
ErrorControl = %SERVICE_ERROR_IGNORE%
ServiceBinary = %13%\virtio_wddm_rs.sys

[VirtioGpu_EventLog_Inst]
AddReg = VirtioGpu_EventLog_Inst.AddReg

[VirtioGpu_EventLog_Inst.AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[VirtioGpu_DeviceSettings]
HKR,, OpenGLDriverNameWow, %REG_SZ%, "%13%\droidvm_opengl_x86.dll"
HKR,, VulkanDriverNameWow, %REG_SZ%, "%13%\freedreno_icd.x86.json"
HKR,, UserModeDriverNameWow, %REG_MULTI_SZ%, <>,%13%\dx11um_virtio_x86.dll,%13%\dx11um_virtio_x86.dll,%13%\dx12um_virtio_x86.dll
HKR,, OpenGLFlagsWow, %REG_DWORD%, 1
HKR,, OpenGLVersionWow, %REG_DWORD%, 2
HKR,, UserModeDriverName, %REG_MULTI_SZ%, <>,%13%\dx11um_virtio.dll,%13%\dx11um_virtio.dll,%13%\dx12um_virtio.dll
HKR,, D3D12Enable, %REG_DWORD%, 1
HKR,, D3D12FeatureLevelOverride, %REG_DWORD%, 0
HKR,, VulkanDriverName, %REG_SZ%, "%13%\freedreno_icd.arm64x.json"
HKR,, OpenGLDriverName, %REG_SZ%, "%13%\droidvm_opengl.dll"
HKR,, OpenGLVersion, %REG_DWORD%, 2
HKR,, OpenGLFlags, %REG_DWORD%, 1

[VirtioGpu_PCI_MSIX]
HKR, "Interrupt Management",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 0
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 4

[Strings]
diskId1 = "VirtIO GPU controller Installation Disk"
VirtioGpu.DeviceDesc = "VirtIO GPU 3D controller"
ManufacturerName = "anonymix007"
SERVICE_BOOT_START = 0x0
SERVICE_SYSTEM_START = 0x1
SERVICE_AUTO_START = 0x2
SERVICE_DEMAND_START = 0x3
SERVICE_DISABLED = 0x4
SERVICE_KERNEL_DRIVER = 0x1
SERVICE_ERROR_IGNORE = 0x0
SERVICE_ERROR_NORMAL = 0x1
SERVICE_ERROR_SEVERE = 0x2
SERVICE_ERROR_CRITICAL = 0x3
REG_SZ        = 0x00000000
REG_MULTI_SZ  = 0x00010000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001


